[TEMPLATE]

# --- intervals.icu OAuth application ---
# Data comes through intervals.icu (which itself syncs your Strava account), so
# no Strava client credentials are needed. To create an app, email
# david@intervals.icu with: app name, description, website URL, a square logo
# (≥128x128), a privacy policy URL, and your redirect URI (see below). You will
# receive a client_id and client_secret from the "Manage App" page under
# https://intervals.icu/settings.
#   - Client id is numeric; if it comes back prefixed with "i" the app strips it.
#   - The API key is your OAuth client_secret.
INTERVALS_CLIENT_ID=
INTERVALS_API_KEY=

# URL de redirection OAuth : codée en dur dans src/lib/intervals.server.ts
# (https://plans3.lovable.app/api/intervals/callback). Aucune variable
# d'environnement nécessaire. Pense à l'enregistrer chez intervals.icu
# (Manage App → Redirect URI's).

# --- Turso database (https://turso.tech) ---
# Stores sessions, the app state (planning data) and intervals.icu tokens.
TURSO_DATABASE_URL=libsql://your-database-org.turso.io
TURSO_AUTH_TOKEN=

# --- Session cookie signing ---
# Optional. If unset, the app generates and persists a random secret in the
# database so sessions survive restarts. Set this for extra control across
# deploys. Use a long random string.
SESSION_SECRET=

# --- Server ---
PORT=8080