[TEMPLATE]

# --- COROS (optionnel) ---
# La connexion COROS se fait depuis la page « COROS » de l'application :
# e-mail + mot de passe saisis dans l'interface, puis token stocké sur la
# session. Aucune variable d'environnement requise pour se connecter.
#   - COROS_API_URL est optionnel : défaut https://teameuapi.coros.com (Europe).
#     Amérique : https://teamapi.coros.com — Chine : https://teamcnapi.coros.com
COROS_API_URL=

# --- Turso database (https://turso.tech) ---
# Stores sessions, the app state (planning data) and the COROS access token.
TURSO_DATABASE_URL=libsql://your-database-org.turso.io
TURSO_AUTH_TOKEN=

# --- Session cookie signing ---
# Optional. If unset, the app generates and persists a random secret in the
# database so sessions survive restarts. Set this for extra control across
# deploys. Use a long random string.
SESSION_SECRET=

# --- Server ---
PORT=8080
