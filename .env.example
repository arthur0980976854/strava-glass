# Strava OAuth application (https://www.strava.com/settings/api)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Random string you choose; must match the verify_token used when creating the webhook subscription
STRAVA_VERIFY_TOKEN=

# Turso database (https://turso.tech)
TURSO_DATABASE_URL=libsql://your-database-org.turso.io
TURSO_AUTH_TOKEN=

PORT=8080
